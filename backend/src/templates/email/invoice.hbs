<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Invoice - {{invoiceNumber}}</title>
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="background: #1a365d; color: white; padding: 20px; border-radius: 8px 8px 0 0;">
    <h1 style="margin: 0; font-size: 24px;">🏠 ImaraRent</h1>
    <p style="margin: 5px 0 0; opacity: 0.8;">Invoice {{invoiceNumber}}</p>
  </div>

  <div style="padding: 20px; background: #f7fafc; border-radius: 0 0 8px 8px;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
      <div>
        <p style="margin: 5px 0;"><strong>Tenant</strong></p>
        <p style="margin: 5px 0;">{{tenantName}}</p>
        <p style="margin: 5px 0;">{{tenantEmail}}</p>
        <p style="margin: 5px 0;">{{tenantPhone}}</p>
      </div>
      <div style="text-align: right;">
        <p style="margin: 5px 0;"><strong>Issue Date</strong></p>
        <p style="margin: 5px 0;">{{formatDate issueDate}}</p>
        <p style="margin: 5px 0;"><strong>Due Date</strong></p>
        <p style="margin: 5px 0;">{{formatDate dueDate}}</p>
      </div>
    </div>

    <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
      <thead style="background: #e2e8f0;">
        <tr>
          <th style="padding: 10px; text-align: left;">Description</th>
          <th style="padding: 10px; text-align: right;">Amount</th>
        </tr>
      </thead>
      <tbody>
        {{#each lines}}
        <tr>
          <td style="padding: 8px 10px; border-bottom: 1px solid #e2e8f0;">{{description}}</td>
          <td style="padding: 8px 10px; border-bottom: 1px solid #e2e8f0; text-align: right;">{{formatCurrency amount}}</td>
        </tr>
        {{/each}}
      </tbody>
      <tfoot>
        <tr>
          <td style="padding: 10px; font-weight: bold;">Total</td>
          <td style="padding: 10px; text-align: right; font-weight: bold; font-size: 18px;">{{formatCurrency totalAmount}}</td>
        </tr>
        <tr>
          <td style="padding: 10px; color: #718096;">Paid</td>
          <td style="padding: 10px; text-align: right; color: #718096;">{{formatCurrency paidAmount}}</td>
        </tr>
        <tr>
          <td style="padding: 10px; font-weight: bold; color: #2b6cb0;">Balance</td>
          <td style="padding: 10px; text-align: right; font-weight: bold; color: #2b6cb0; font-size: 18px;">{{formatCurrency balance}}</td>
        </tr>
      </tfoot>
    </table>

    <div style="background: #e8f0fe; padding: 15px; border-radius: 6px; margin: 20px 0;">
      <p style="margin: 0; font-size: 14px;">
        <strong>Property:</strong> {{propertyName}}<br>
        <strong>Unit:</strong> {{unitNumber}}<br>
        <strong>Payment Reference:</strong> {{invoiceNumber}}
      </p>
    </div>

    <div style="text-align: center; margin: 30px 0;">
      <a href="{{paymentLink}}"
         style="background-color: #2b6cb0; color: white; padding: 14px 40px; text-decoration: none; border-radius: 6px; font-weight: bold; display: inline-block;">
        Pay Now
      </a>
    </div>

    <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 20px 0;">

    <p style="font-size: 12px; color: #718096; text-align: center;">
      This is an automated invoice from ImaraRent. Please contact your property manager for any questions.
    </p>
  </div>
</body>
</html>